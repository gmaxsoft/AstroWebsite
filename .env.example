# Skopiuj do .env (nie commituj .env)

# Cloudflare Turnstile – Site Key (publiczny, trafia do HTML przy buildzie)
# Dashboard: Cloudflare → Turnstile → Create → skopiuj Site Key
PUBLIC_TURNSTILE_SITE_KEY=

# SMTP / Turnstile Secret są TYLKO na serwerze:
# /var/www/html/maxsoft.pl/config/smtp.php  (patrz deploy/nginx/smtp.php.example)
