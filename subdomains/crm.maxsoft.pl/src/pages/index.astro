---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Maxsoft CRM – System CRM Laravel 12 + Livewire | Zarządzanie relacjami z klientami"
  description="Maxsoft CRM to nowoczesny system CRM oparty o Laravel 12, Blade i Livewire. Centralizacja danych o klientach, automatyzacja sprzedaży i marketingu. Dla firm z Zielonej Góry i okolic."
  canonical="https://crm.maxsoft.pl/"
>
  <header class="crm-header" id="header">
    <div class="container">
      <a href="https://www.maxsoft.pl" class="crm-logo" title="Maxsoft – strona główna">
        Maxsoft
      </a>
      <nav class="crm-nav" aria-label="Menu główne">
        <a href="#funkcje">Funkcje</a>
        <a href="#technologie">Technologie</a>
        <a href="#kontakt">Kontakt</a>
        <a href="https://www.maxsoft.pl/oferta/" title="Oferta Maxsoft">Oferta</a>
        <a href="https://www.maxsoft.pl/kontakt/" class="crm-btn" title="Skontaktuj się z Maxsoft">
          Skontaktuj się
        </a>
      </nav>
      <button class="crm-menu-btn" aria-label="Otwórz menu" type="button">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </header>

  <main>
    <section class="crm-hero" aria-labelledby="hero-heading">
      <div class="container">
        <div class="crm-hero-content">
          <h1 id="hero-heading">
            <span class="mil-thin">System CRM</span><br />
            Modułowy i Skalowalny
          </h1>
          <p>
            Nowoczesny system zarządzania relacjami z klientami. Centralizacja danych, 
            automatyzacja sprzedaży i marketingu – wszystko w jednym miejscu, bez Excela.
          </p>
          <div class="crm-hero-buttons">
            <a href="https://www.maxsoft.pl/kontakt/" class="crm-btn" title="Poproś o wycenę CRM">
              Poproś o wycenę
            </a>
            <a href="#funkcje" class="crm-btn crm-btn-outline" title="Poznaj funkcje CRM">
              Poznaj funkcje
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="crm-section crm-section-dark" id="funkcje" aria-labelledby="funkcje-heading">
      <div class="container">
        <div class="crm-section-title">
          <span>Co oferuje</span>
          <h2 id="funkcje-heading">Kluczowe Funkcje Systemu</h2>
        </div>
        <div class="crm-features">
          <article class="crm-feature-card">
            <div class="crm-feature-icon" aria-hidden="true">📊</div>
            <h3>Centralizacja danych o klientach</h3>
            <p>
              Wszystkie informacje o klientach (historia kontaktu, maile, zakupy) znajdują się w jednym miejscu,
              co zapewnia szybki dostęp do danych.
            </p>
          </article>
          <article class="crm-feature-card">
            <div class="crm-feature-icon" aria-hidden="true">🎯</div>
            <h3>Usprawnienie procesu sprzedaży</h3>
            <p>
              Śledzenie etapów lejka sprzedażowego pozwala na lepsze zarządzanie transakcjami
              i szybkie zamykanie sprzedaży.
            </p>
          </article>
          <article class="crm-feature-card">
            <div class="crm-feature-icon" aria-hidden="true">📈</div>
            <h3>Analiza i raportowanie</h3>
            <p>
              Raporty sprzedaży, pipeline’y, konwersje. Śledź efektywność zespołu 
              i identyfikuj najlepsze kanały pozyskiwania klientów.
            </p>
          </article>
          <article class="crm-feature-card">
            <div class="crm-feature-icon" aria-hidden="true">⚡</div>
            <h3>Automatyzacja procesów</h3>
            <p>
              Automatyczne powiadomienia, przypomnienia, workflow. 
              Oszczędzaj czas na powtarzalnych zadaniach.
            </p>
          </article>
          <article class="crm-feature-card">
            <div class="crm-feature-icon" aria-hidden="true">📧</div>
            <h3>Automatyzacja działań <span class="mil-thin">(Marketing Automation)</span></h3>
            <p>
              System automatyzuje powtarzalne zadania, takie jak wysyłka e-maili, raportowanie
              czy przypomnienia o spotkaniach, co odciąża pracowników.
            </p>
          </article>
          <article class="crm-feature-card">
            <div class="crm-feature-icon" aria-hidden="true">🤝</div>
            <h3>Poprawa obsługi i lojalności klientów</h3>
            <p>
              Personalizacja oferty oraz szybszy czas reakcji na potrzeby klienta zwiększają
              ich satysfakcję i retencję.
            </p>
          </article>
          <article class="crm-feature-card">
            <div class="crm-feature-icon" aria-hidden="true">👥</div>
            <h3>Lepsza komunikacja wewnątrz firmy</h3>
            <p>
              Ułatwia wymianę informacji między działami (np. sprzedaży i marketingu)
              oraz monitorowanie odpowiedzialności za konkretne zadania.
            </p>
          </article>
          <article class="crm-feature-card">
            <div class="crm-feature-icon" aria-hidden="true">🔗</div>
            <h3>Integracje</h3>
            <p>
              Połączenie z e-mail, kalendarzem, sklepem internetowym i innymi systemami. 
              Jedna platforma dla całego biznesu.
            </p>
          </article>
          <article class="crm-feature-card">
            <div class="crm-feature-icon" aria-hidden="true">🧩</div>
            <h3>Modułowość i skalowalność</h3>
            <p>
              Architektura oparta na modułach – włączasz tylko to, czego potrzebujesz. 
              System rośnie razem z firmą: od małego zespołu po większą organizację.
            </p>
          </article>
        </div>

        <!-- Carousel – dodaj pliki do /img/carousel/ i podmień src w każdym img -->
        <div class="crm-carousel-wrapper">
          <div class="crm-carousel" aria-label="Galeria zdjęć systemu CRM">
            <button type="button" class="crm-carousel-btn crm-carousel-prev" aria-label="Poprzedni slajd">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M15 18l-6-6 6-6"/>
              </svg>
            </button>
            <div class="crm-carousel-track">
              <div class="crm-carousel-slide crm-carousel-active">
                <button
                  type="button"
                  class="crm-carousel-open-lightbox"
                  aria-haspopup="dialog"
                  aria-label="Otwórz powiększenie: zrzut ekranu 1"
                  data-carousel-index="0"
                >
                  <img src="/img/carousel/login.webp" alt="Zrzut ekranu systemu CRM 1" width="800" height="500" loading="eager" decoding="async" />
                </button>
              </div>
              <div class="crm-carousel-slide">
                <button
                  type="button"
                  class="crm-carousel-open-lightbox"
                  aria-haspopup="dialog"
                  aria-label="Otwórz powiększenie: zrzut ekranu 2"
                  data-carousel-index="1"
                >
                  <img src="/img/carousel/panel.webp" alt="Zrzut ekranu systemu CRM 2" width="800" height="500" loading="lazy" decoding="async" />
                </button>
              </div>
              <div class="crm-carousel-slide">
                <button
                  type="button"
                  class="crm-carousel-open-lightbox"
                  aria-haspopup="dialog"
                  aria-label="Otwórz powiększenie: zrzut ekranu 3"
                  data-carousel-index="2"
                >
                  <img src="/img/carousel/panel2.webp" alt="Zrzut ekranu systemu CRM 3" width="800" height="500" loading="lazy" decoding="async" />
                </button>
              </div>
            </div>
            <button type="button" class="crm-carousel-btn crm-carousel-next" aria-label="Następny slajd">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M9 18l6-6-6-6"/>
              </svg>
            </button>
          </div>
          <div class="crm-carousel-dots" role="tablist" aria-label="Wybierz slajd">
            <button type="button" role="tab" aria-selected="true" aria-label="Slajd 1" data-slide="0" class="crm-carousel-dot crm-carousel-dot-active"></button>
            <button type="button" role="tab" aria-selected="false" aria-label="Slajd 2" data-slide="1" class="crm-carousel-dot"></button>
            <button type="button" role="tab" aria-selected="false" aria-label="Slajd 3" data-slide="2" class="crm-carousel-dot"></button>
          </div>
        </div>

        <dialog class="crm-lightbox" id="crm-lightbox" aria-labelledby="crm-lightbox-title">
          <h2 id="crm-lightbox-title" class="crm-lightbox-sr-only">Powiększone zdjęcie galerii</h2>
          <button type="button" class="crm-lightbox-scrim" aria-label="Zamknij podgląd" tabindex="-1"></button>
          <div class="crm-lightbox-frame">
            <button type="button" class="crm-lightbox-close" aria-label="Zamknij">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M18 6L6 18M6 6l12 12"/>
              </svg>
            </button>
            <img class="crm-lightbox-img" src="" alt="" width="1200" height="750" decoding="async" />
            <button type="button" class="crm-lightbox-nav crm-lightbox-prev" aria-label="Poprzednie zdjęcie">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M15 18l-6-6 6-6"/>
              </svg>
            </button>
            <button type="button" class="crm-lightbox-nav crm-lightbox-next" aria-label="Następne zdjęcie">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M9 18l6-6-6-6"/>
              </svg>
            </button>
          </div>
        </dialog>
      </div>
    </section>

    <section class="crm-section" id="technologie" aria-labelledby="tech-heading">
      <div class="container">
        <div class="crm-section-title">
          <span>Stack technologiczny</span>
          <h2 id="tech-heading">Zbudowany w nowoczesnych technologiach</h2>
        </div>
        <p class="crm-section-title" style="margin-top: -40px; margin-bottom: 0;">
          Sam wybierasz technologie<br />Laravel lub Symfony, Blade lub Twig, React lub Vue, MySQL lub PostgreSQL<br/>Sprawdzone frameworki dla wydajnych aplikacji biznesowych.
        </p>
        <div class="crm-tech">
          <span class="crm-tech-item"><span>Laravel lub Symfony</span> – backend PHP</span>
          <span class="crm-tech-item"><span>Blade lub Twig</span> – szablony</span>
          <span class="crm-tech-item"><span>React lub Vue</span> – interaktywność</span>
          <span class="crm-tech-item"><span>MySQL lub PostgreSQL</span> – baza danych</span>
        </div>
      </div>
    </section>

    <section class="crm-section crm-section-dark" id="kontakt" aria-labelledby="cta-heading">
      <div class="container">
        <div class="crm-cta">
          <h2 id="cta-heading">Gotowy na własny system CRM?</h2>
          <p>
            Skontaktuj się z nami. Przygotujemy indywidualną wycenę i zaproponujemy 
            rozwiązanie dopasowane do Twojej firmy.
          </p>
          <a href="https://www.maxsoft.pl/kontakt/" class="crm-btn" title="Kontakt z Maxsoft">
            Skontaktuj się z Maxsoft
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="crm-footer">
    <div class="container">
      <nav class="crm-footer-links" aria-label="Linki w stopce">
        <a href="https://www.maxsoft.pl" title="Strona główna Maxsoft">Maxsoft.pl</a>
        <a href="https://www.maxsoft.pl/oferta/" title="Oferta">Oferta</a>
        <a href="https://www.maxsoft.pl/kontakt/" title="Kontakt">Kontakt</a>
        <a href="https://cms.maxsoft.pl" title="Maxsoft CMS">CMS</a>
        <a href="https://erp.maxsoft.pl" title="Maxsoft ERP">ERP</a>
      </nav>
      <p class="crm-footer-copy">© {new Date().getFullYear()} Maxsoft. Wszystkie prawa zastrzeżone.</p>
    </div>
  </footer>

  <script>
    // Header scroll effect
    const header = document.getElementById('header');
    if (header) {
      const onScroll = () => {
        header.classList.toggle('scrolled', window.scrollY > 50);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
    }

    // Carousel
    const slides = document.querySelectorAll('.crm-carousel-slide');
    const dots = document.querySelectorAll('.crm-carousel-dot');
    const prevBtn = document.querySelector('.crm-carousel-prev');
    const nextBtn = document.querySelector('.crm-carousel-next');
    const totalSlides = slides.length;
    let currentIndex = 0;

    function goToSlide(index) {
      currentIndex = (index + totalSlides) % totalSlides;
      slides.forEach((s, i) => s.classList.toggle('crm-carousel-active', i === currentIndex));
      dots.forEach((d, i) => {
        d.classList.toggle('crm-carousel-dot-active', i === currentIndex);
        d.setAttribute('aria-selected', String(i === currentIndex));
      });
    }

    prevBtn?.addEventListener('click', () => goToSlide(currentIndex - 1));
    nextBtn?.addEventListener('click', () => goToSlide(currentIndex + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => goToSlide(i)));

    // Lightbox
    const lightbox = document.getElementById('crm-lightbox');
    const lightboxImg = lightbox?.querySelector('.crm-lightbox-img');
    const lightboxClose = lightbox?.querySelector('.crm-lightbox-close');
    const lightboxScrim = lightbox?.querySelector('.crm-lightbox-scrim');
    const lightboxPrev = lightbox?.querySelector('.crm-lightbox-prev');
    const lightboxNext = lightbox?.querySelector('.crm-lightbox-next');

    function getCarouselSources() {
      return Array.from(document.querySelectorAll('.crm-carousel-slide img')).map((img) => ({
        src: img.getAttribute('src') || '',
        alt: img.getAttribute('alt') || '',
      }));
    }

    let lightboxIndex = 0;
    /** @type {HTMLElement | null} */
    let lightboxReturnFocus = null;

    function syncLightboxImage() {
      const list = getCarouselSources();
      if (!lightboxImg || list.length === 0) return;
      const item = list[lightboxIndex] ?? list[0];
      lightboxImg.src = item.src;
      lightboxImg.alt = item.alt;
    }

    function openLightbox(index, trigger) {
      if (!lightbox || !lightboxImg) return;
      const list = getCarouselSources();
      if (list.length === 0) return;
      lightboxIndex = (index + list.length) % list.length;
      lightboxReturnFocus = trigger;
      syncLightboxImage();
      lightbox.showModal();
      lightboxClose?.focus();
    }

    function stepLightbox(delta) {
      const list = getCarouselSources();
      if (list.length === 0) return;
      lightboxIndex = (lightboxIndex + delta + list.length) % list.length;
      syncLightboxImage();
    }

    document.querySelectorAll('.crm-carousel-open-lightbox').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const i = Number((/** @type {HTMLElement} */ (e.currentTarget)).dataset.carouselIndex);
        openLightbox(Number.isFinite(i) ? i : 0, /** @type {HTMLElement} */ (e.currentTarget));
      });
    });

    lightboxClose?.addEventListener('click', () => lightbox?.close());
    lightboxScrim?.addEventListener('click', () => lightbox?.close());
    lightboxPrev?.addEventListener('click', () => stepLightbox(-1));
    lightboxNext?.addEventListener('click', () => stepLightbox(1));

    lightbox?.addEventListener('close', () => {
      lightboxReturnFocus?.focus();
      lightboxReturnFocus = null;
    });

    lightbox?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        stepLightbox(-1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        stepLightbox(1);
      }
    });
  </script>
</Layout>

<style is:global>
  @import '../styles/global.css';
</style>
