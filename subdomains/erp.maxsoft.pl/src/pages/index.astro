---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Maxsoft ERP – System ERP Laravel 12 + React | Zarządzanie przedsiębiorstwem"
  description="Maxsoft ERP to nowoczesny system ERP oparty o Laravel 12 i React. Finanse, kadry, produkcja, logistyka i sprzedaż w jednej platformie. Dla firm z Zielonej Góry i okolic."
  canonical="https://erp.maxsoft.pl/"
>
  <header class="crm-header" id="header">
    <div class="container">
      <a href="https://www.maxsoft.pl" class="crm-logo" title="Maxsoft – strona główna">
        Maxsoft
      </a>
      <nav class="crm-nav" aria-label="Menu główne">
        <a href="#funkcje">Funkcje</a>
        <a href="#technologie">Technologie</a>
        <a href="#kontakt">Kontakt</a>
        <a href="https://www.maxsoft.pl/oferta/" title="Oferta Maxsoft">Oferta</a>
        <a href="https://www.maxsoft.pl/kontakt/" class="crm-btn" title="Skontaktuj się z Maxsoft">
          Skontaktuj się
        </a>
      </nav>
      <button class="crm-menu-btn" aria-label="Otwórz menu" type="button">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </header>

  <main>
    <section class="crm-hero" aria-labelledby="hero-heading">
      <div class="container">
        <div class="crm-hero-content">
          <h1 id="hero-heading">
            <span class="mil-thin">System ERP</span><br />
            Modułowy i Skalowalny
          </h1>
          <p>
            Kompleksowe zarządzanie przedsiębiorstwem. Finanse, kadry, produkcja, 
            logistyka i sprzedaż – wszystko w jednej nowoczesnej platformie.
          </p>
          <div class="crm-hero-buttons">
            <a href="https://www.maxsoft.pl/kontakt/" class="crm-btn" title="Poproś o wycenę ERP">
              Poproś o wycenę
            </a>
            <a href="#funkcje" class="crm-btn crm-btn-outline" title="Poznaj funkcje ERP">
              Poznaj funkcje
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="crm-section crm-section-dark" id="funkcje" aria-labelledby="funkcje-heading">
      <div class="container">
        <div class="crm-section-title">
          <span>Co oferuje</span>
          <h2 id="funkcje-heading">Kluczowe cechy systemu</h2>
        </div>
        <div class="crm-features">
          <article class="crm-feature-card">
            <div class="crm-feature-icon" aria-hidden="true">💰</div>
            <h3>Finanse i księgowość</h3>
            <p>
              Zarządzanie finansami, faktury, rozliczenia, budżety. 
              Pełna kontrola nad przepływem środków w firmie.
            </p>
          </article>
          <article class="crm-feature-card">
            <div class="crm-feature-icon" aria-hidden="true">👥</div>
            <h3>Kadry i HR</h3>
            <p>
              Rekrutacja, ewidencja pracowników, urlopy, dokumentacja. 
              Usprawnione zarządzanie zasobami ludzkimi.
            </p>
          </article>
          <article class="crm-feature-card">
            <div class="crm-feature-icon" aria-hidden="true">🏭</div>
            <h3>Produkcja</h3>
            <p>
              Planowanie produkcji, zarządzanie zasobami, harmonogramy. 
              Optymalizacja procesów wytwórczych.
            </p>
          </article>
          <article class="crm-feature-card">
            <div class="crm-feature-icon" aria-hidden="true">📦</div>
            <h3>Logistyka i sprzedaż</h3>
            <p>
              Magazyn, zamówienia, dostawy, integracja z CRM. 
              Kompleksowa obsługa łańcucha dostaw.
            </p>
          </article>
          <article class="crm-feature-card">
            <div class="crm-feature-icon" aria-hidden="true">📈</div>
            <h3>Elastyczność i skalowalność</h3>
            <p>
              Dobry system ERP dostosowuje się do zmieniających się procesów biznesowych i rośnie wraz z firmą,
              obsługując większą liczbę użytkowników lub transakcji.
            </p>
          </article>
          <article class="crm-feature-card">
            <div class="crm-feature-icon" aria-hidden="true">🧩</div>
            <h3>Modułowość</h3>
            <p>
              Systemy ERP są budowane z modułów, co pozwala na dopasowanie oprogramowania do specyficznych potrzeb firmy.
              Przedsiębiorstwo może wdrożyć tylko potrzebne moduły (np. finanse i magazyn) i dokupić kolejne w miarę rozwoju.
            </p>
          </article>
        </div>

        <div class="crm-carousel-wrapper">
          <div class="crm-carousel" aria-label="Galeria zdjęć systemu ERP">
            <button type="button" class="crm-carousel-btn crm-carousel-prev" aria-label="Poprzedni slajd">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M15 18l-6-6 6-6"/>
              </svg>
            </button>
            <div class="crm-carousel-track">
              <div class="crm-carousel-slide crm-carousel-active">
                <button type="button" class="crm-carousel-img-btn" aria-label="Powiększ — schemat systemu ERP">
                  <img src="/img/carousel/schemat.webp" alt="Schemat systemu ERP" width="800" height="500" loading="eager" />
                </button>
              </div>
              <div class="crm-carousel-slide">
                <button type="button" class="crm-carousel-img-btn" aria-label="Powiększ — panel systemu ERP">
                  <img src="/img/carousel/panel.webp" alt="Panel systemu ERP" width="800" height="500" loading="lazy" />
                </button>
              </div>
              <div class="crm-carousel-slide">
                <button type="button" class="crm-carousel-img-btn" aria-label="Powiększ — widok ERP">
                  <img src="/img/carousel/erp.webp" alt="Widok systemu ERP" width="800" height="500" loading="lazy" />
                </button>
              </div>
            </div>
            <button type="button" class="crm-carousel-btn crm-carousel-next" aria-label="Następny slajd">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M9 18l6-6-6-6"/>
              </svg>
            </button>
          </div>
          <div class="crm-carousel-dots" role="tablist" aria-label="Wybierz slajd">
            <button type="button" role="tab" aria-selected="true" aria-label="Slajd 1" data-slide="0" class="crm-carousel-dot crm-carousel-dot-active"></button>
            <button type="button" role="tab" aria-selected="false" aria-label="Slajd 2" data-slide="1" class="crm-carousel-dot"></button>
            <button type="button" role="tab" aria-selected="false" aria-label="Slajd 3" data-slide="2" class="crm-carousel-dot"></button>
          </div>
        </div>

        <div id="crm-lightbox" class="crm-lightbox" role="dialog" aria-modal="true" aria-label="Powiększona galeria zdjęć" hidden>
          <button type="button" class="crm-lightbox-backdrop" aria-label="Zamknij galerię"></button>
          <div class="crm-lightbox-layer">
            <button type="button" class="crm-lightbox-close" aria-label="Zamknij galerię">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M18 6L6 18M6 6l12 12"/>
              </svg>
            </button>
            <button type="button" class="crm-lightbox-prev-lg" aria-label="Poprzednie zdjęcie">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M15 18l-6-6 6-6"/>
              </svg>
            </button>
            <button type="button" class="crm-lightbox-next-lg" aria-label="Następne zdjęcie">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M9 18l6-6-6-6"/>
              </svg>
            </button>
            <figure class="crm-lightbox-stage">
              <img src="" alt="" width="1200" height="800" />
            </figure>
          </div>
        </div>
      </div>
    </section>

    <section class="crm-section" id="technologie" aria-labelledby="tech-heading">
      <div class="container">
        <div class="crm-section-title">
          <span>Stack technologiczny</span>
          <h2 id="tech-heading">Zbudowany w nowoczesnych technologiach</h2>
        </div>
        <p class="crm-section-title" style="margin-top: -40px; margin-bottom: 0;">
          Laravel 12 i najnowszy React – wydajny backend i dynamiczny interfejs użytkownika.
        </p>
        <div class="crm-tech">
          <span class="crm-tech-item"><span>Vue.js lub React</span> – frontend</span>
          <span class="crm-tech-item"><span>Laravel lub Symfony</span> – backend</span>
          <span class="crm-tech-item"><span>MySQL lub PostgreSQL</span> – baza danych</span>
          <span class="crm-tech-item"><span>Git</span> – wersjonowanie</span>
          <span class="crm-tech-item"><span>Tailwind CSS</span> – stylizacja</span>
          <span class="crm-tech-item"><span>Typescript</span> – język programowania</span>
          <span class="crm-tech-item"><span>Azure lub AWS</span> – hosting</span>
        </div>
      </div>
    </section>

    <section class="crm-section crm-section-dark" id="kontakt" aria-labelledby="cta-heading">
      <div class="container">
        <div class="crm-cta">
          <h2 id="cta-heading">Gotowy na <span class="mil-accent">własny system ERP</span>?</h2>
          <p>
            Skontaktuj się z nami. Przygotujemy indywidualną wycenę i zaproponujemy 
            rozwiązanie dopasowane do Twojej firmy.
          </p>
          <a href="https://www.maxsoft.pl/kontakt/" class="crm-btn" title="Kontakt z Maxsoft">
            Skontaktuj się z Maxsoft
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="crm-footer">
    <div class="container">
      <nav class="crm-footer-links" aria-label="Linki w stopce">
        <a href="https://www.maxsoft.pl" title="Strona główna Maxsoft">Maxsoft.pl</a>
        <a href="https://www.maxsoft.pl/oferta/" title="Oferta">Oferta</a>
        <a href="https://www.maxsoft.pl/kontakt/" title="Kontakt">Kontakt</a>
        <a href="https://cms.maxsoft.pl" title="Maxsoft CMS">CMS</a>
        <a href="https://crm.maxsoft.pl" title="Maxsoft CRM">CRM</a>
      </nav>
      <p class="crm-footer-copy">© {new Date().getFullYear()} Maxsoft. Wszystkie prawa zastrzeżone.</p>
    </div>
  </footer>

  <script>
    // @ts-nocheck
    const header = document.getElementById('header');
    if (header) {
      const onScroll = () => { header.classList.toggle('scrolled', window.scrollY > 50); };
      window.addEventListener('scroll', onScroll, { passive: true });
    }
    const slides = document.querySelectorAll('.crm-carousel-slide');
    const dots = document.querySelectorAll('.crm-carousel-dot');
    const prevBtn = document.querySelector('.crm-carousel-prev');
    const nextBtn = document.querySelector('.crm-carousel-next');
    const lightbox = document.getElementById('crm-lightbox');
    const lightboxImgEl = lightbox?.querySelector('.crm-lightbox-stage img');
    const lightboxImg = lightboxImgEl instanceof HTMLImageElement ? lightboxImgEl : null;
    const lightboxBackdrop = lightbox?.querySelector('.crm-lightbox-backdrop');
    const lightboxClose = lightbox?.querySelector('.crm-lightbox-close');
    const lightboxPrev = lightbox?.querySelector('.crm-lightbox-prev-lg');
    const lightboxNext = lightbox?.querySelector('.crm-lightbox-next-lg');
    const totalSlides = slides.length;
    let currentIndex = 0;
    let lightboxIndex = 0;
    let lightboxReturnFocus = null;

    function goToSlide(index) {
      currentIndex = ((index % totalSlides) + totalSlides) % totalSlides;
      slides.forEach((s, i) => s.classList.toggle('crm-carousel-active', i === currentIndex));
      dots.forEach((d, i) => {
        d.classList.toggle('crm-carousel-dot-active', i === currentIndex);
        d.setAttribute('aria-selected', String(i === currentIndex));
      });
    }

    function getSlideSources() {
      return Array.from(slides).map((s) => {
        const img = s.querySelector('img');
        return { src: img?.getAttribute('src') || '', alt: img?.getAttribute('alt') || '' };
      });
    }

    function updateLightboxImage() {
      const items = getSlideSources();
      const item = items[lightboxIndex];
      if (lightboxImg && item) {
        lightboxImg.src = item.src;
        lightboxImg.alt = item.alt;
      }
    }

    function openLightbox(index) {
      if (!lightbox || !lightboxImg) return;
      const ae = document.activeElement;
      lightboxReturnFocus = ae instanceof HTMLElement ? ae : null;
      lightboxIndex = ((index % totalSlides) + totalSlides) % totalSlides;
      updateLightboxImage();
      lightbox.removeAttribute('hidden');
      document.body.classList.add('crm-lightbox-open');
      if (lightboxClose instanceof HTMLElement) lightboxClose.focus();
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.setAttribute('hidden', '');
      document.body.classList.remove('crm-lightbox-open');
      if (lightboxReturnFocus instanceof HTMLElement) {
        lightboxReturnFocus.focus();
        lightboxReturnFocus = null;
      }
    }

    function lightboxStep(delta) {
      lightboxIndex = (lightboxIndex + delta + totalSlides) % totalSlides;
      updateLightboxImage();
    }

    prevBtn?.addEventListener('click', () => goToSlide(currentIndex - 1));
    nextBtn?.addEventListener('click', () => goToSlide(currentIndex + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => goToSlide(i)));

    slides.forEach((slide, i) => {
      slide.querySelector('.crm-carousel-img-btn')?.addEventListener('click', () => openLightbox(i));
    });

    lightboxBackdrop?.addEventListener('click', closeLightbox);
    lightboxClose?.addEventListener('click', closeLightbox);
    lightboxPrev?.addEventListener('click', (e) => {
      e.stopPropagation();
      lightboxStep(-1);
    });
    lightboxNext?.addEventListener('click', (e) => {
      e.stopPropagation();
      lightboxStep(1);
    });

    document.addEventListener('keydown', (e) => {
      if (!lightbox || lightbox.hasAttribute('hidden')) return;
      if (e.key === 'Escape') {
        closeLightbox();
        return;
      }
      if (e.key === 'ArrowLeft') lightboxStep(-1);
      if (e.key === 'ArrowRight') lightboxStep(1);
    });
  </script>
</Layout>

<style is:global>
  @import '../styles/global.css';
</style>
