---
export const prerender = true;

import PageLayout from "../../layouts/PageLayout.astro";
import ContentProjectsSingle from "../../components/ContentProjectsSingle.astro";
import pl from "../../i18n/pl.json";
import type { GetStaticPathsResult } from "astro";
import {
  type ProjectJson,
  getProjectMetaDescription,
  getProjectOgImagePath,
  getProjectPageTitle,
} from "../../utils/projectMeta";

type Project = Record<string, any>;
type Neighbor = {
  slug: string | null;
  title: string | null;
};

export async function getStaticPaths(): Promise<GetStaticPathsResult> {
  const projectsList = (pl.projekt as Project[]) || [];

  return projectsList.map((projekt, index) => {
    const prevIndex = index - 1;
    const prevProjectData = prevIndex >= 0 ? projectsList[prevIndex] : null;
    const nextIndex = index + 1;
    const nextProjectData = nextIndex < projectsList.length ? projectsList[nextIndex] : null;

    const prevProject: Neighbor = {
      slug: prevProjectData ? `projekty/${prevProjectData.slug}` : null,
      title: prevProjectData ? prevProjectData.title : null,
    };
    const nextProject: Neighbor = {
      slug: nextProjectData ? `projekty/${nextProjectData.slug}` : null,
      title: nextProjectData ? nextProjectData.title : null,
    };

    return {
      params: { slug: projekt.slug },
      props: {
        projectData: projekt,
        prevProject,
        nextProject,
      },
    };
  });
}

const { projectData: rawProject, prevProject, nextProject } = Astro.props;
const projectData = rawProject as ProjectJson;

const pageTitle = getProjectPageTitle(
  projectData.title,
  pl.projekty.projektytxt01,
);
const description = getProjectMetaDescription(projectData);
const ogImage = getProjectOgImagePath(String(projectData.number));
const canonical = `https://www.maxsoft.pl/projekty/${projectData.slug}/`;
const ogImageAlt = (pl.projekty.altGalleryView1 as string).replace(
  "{title}",
  projectData.title,
);
---

<PageLayout
  lang="pl"
  title={pageTitle}
  description={description}
  ogImage={ogImage}
  canonical={canonical}
  openGraphImageAlt={ogImageAlt}
>
  <ContentProjectsSingle
    data={projectData}
    prevProject={prevProject}
    nextProject={nextProject}
    langPrefix=""
    lang="pl"
  />
</PageLayout>
