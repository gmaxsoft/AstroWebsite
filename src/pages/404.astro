---
export const prerender = true;

import ErrorLayout from "../layouts/ErrorLayout.astro";
import ErrorContent from "../components/ErrorContent.astro";
import pl from "../i18n/pl.json";

const pageData = pl.error;
const contentFooter = pl.footer;
const contentMenu = pl.menu;

Astro.response.status = 404;
---

<ErrorLayout
  lang="pl"
  langPrefix=""
  title={pageData.title}
  description={pageData.description}
  ogImage={pageData.ogimage || "/img/default-og.webp"}
  currentLocale="pl"
  contentMenu={contentMenu}
  contentFooter={contentFooter}
>
  <>
    <ErrorContent data={pageData} langPrefix="" />
    <div class="mil-u-hidden" aria-hidden="true"></div>
  </>
</ErrorLayout>
