---
export const prerender = true;

import { getCollection } from "astro:content";
import PageLayout from "../../../../layouts/PageLayout.astro";
import AppsIndexContent from "../../../../components/apps/AppsIndexContent.astro";
import pl from "../../../../i18n/pl.json";
import en from "../../../../i18n/en.json";
import { sortAppEntries, APPS_INDEX_PAGE_SIZE } from "../../../../utils/apps";

const translations = { pl, en };

export async function getStaticPaths() {
  const items = sortAppEntries(await getCollection("apps"));
  const totalPages = Math.max(1, Math.ceil(items.length / APPS_INDEX_PAGE_SIZE));
  if (totalPages <= 1) return [];
  return Array.from({ length: totalPages - 1 }, (_, i) => ({
    params: { lang: "en" as const, page: String(i + 2) },
  }));
}

const { lang, page: pageParam } = Astro.params as { lang: "en"; page: string };
const langPrefix = `/${lang}`;
const appsUi = translations[lang].apps;
const pageNum = Math.max(2, parseInt(pageParam ?? "2", 10) || 2);

const items = sortAppEntries(await getCollection("apps"));
const totalPages = Math.max(1, Math.ceil(items.length / APPS_INDEX_PAGE_SIZE));

if (pageNum > totalPages) {
  return Astro.redirect(`${langPrefix}/aplikacje-mobilne/`);
}

const start = (pageNum - 1) * APPS_INDEX_PAGE_SIZE;
const pageItems = items.slice(start, start + APPS_INDEX_PAGE_SIZE);
const canonical = `https://www.maxsoft.pl${langPrefix}/aplikacje-mobilne/page/${pageNum}/`;
---

<PageLayout
  lang={lang}
  title={`${appsUi.breadcrumb} – ${appsUi.pageLabel} ${pageNum} | Maxsoft`}
  description={appsUi.indexDescription}
  ogImage="/img/default-og.webp"
  canonical={canonical}
  openGraphImageAlt={appsUi.breadcrumb}
>
  <div class="mil-inner-banner mil-blog-banner">
    <div class="mil-animation-frame">
      <div
        class="mil-animation mil-position-4 mil-dark mil-scale"
        data-value-1="6"
        data-value-2="1.4"
      >
      </div>
    </div>
    <div class="mil-banner-content mil-up">
      <div class="container">
        <ul class="mil-breadcrumbs mil-mb-60">
          <li>
            <a href={`${langPrefix}/`} title="Start">Start</a>
          </li>
          <li>
            <a href={`${langPrefix}/aplikacje-mobilne/`} title={appsUi.breadcrumb}
              >{appsUi.breadcrumb}</a
            >
          </li>
          <li>
            <span>{appsUi.pageLabel} {pageNum}</span>
          </li>
        </ul>
        <h1 class="mil-mb-15" set:html={appsUi.indexHeading} />
        <p class="mil-text-sm mil-dark-soft mil-up mil-mb-60">
          {appsUi.indexSubheading}
        </p>
      </div>
    </div>
  </div>

  <section class="mil-soft-bg">
    <div class="container mil-p-120-90">
      <AppsIndexContent
        pageItems={pageItems}
        currentPage={pageNum}
        totalPages={totalPages}
        pathPrefix={`${langPrefix}/aplikacje-mobilne`}
        lang={lang}
        readMore={appsUi.readMore}
        pagerPrev={appsUi.pagerPrev}
        pagerNext={appsUi.pagerNext}
        pagerAria={appsUi.pagerAria}
      />
    </div>
  </section>
</PageLayout>
