---
const { langPrefix } = Astro.props;
const prefix = langPrefix ?? "/";
const { data } = Astro.props;

type EcommerceItem = { title: string; description: string };
const ecommerceItems = (data.ecommerceItems as EcommerceItem[]) || [];
const paymentItems = (data.paymentItems as string[]) || [];
const paymentIndex = ecommerceItems.length + 1;
---

<!-- banner -->
<div class="mil-inner-banner">
  <div class="mil-animation-frame">
    <div
      class="mil-animation mil-position-4 mil-dark mil-scale"
      data-value-1="6"
      data-value-2="1.4"
    >
    </div>
  </div>
  <div class="mil-banner-content mil-up">
    <div class="container">
      <ul class="mil-breadcrumbs mil-mb-60">
        <li>
          <a href={prefix ? `${prefix}/` : "/"} title="Start">Start</a>
        </li>
        <li>
          <span title={data.breadcrumb}>{data.breadcrumb}</span>
        </li>
      </ul>
      <h1 class="mil-mb-60" set:html={data.heading} />
      <a
        href="#ecommerce-intro"
        class="mil-link mil-dark mil-arrow-place mil-down-arrow mil-mb-40"
      >
        <span>{data.scrolltxt}</span>
      </a>
    </div>
  </div>
</div>
<!-- banner end -->

<!-- intro -->
<section id="ecommerce-intro">
  <div class="container mil-p-120-90">
    <div class="row justify-content-center">
      <div class="col-lg-10">
        <h2 class="mil-up mil-mb-30" set:html={data.h2Intro} />
        <p class="mil-up mil-mb-30 mil-text-justify mil-dark">
          {data.intro1}
        </p>
        <p class="mil-up mil-mb-30 mil-text-justify mil-dark">
          {data.intro2}
        </p>
        <div class="mil-up">
          <a
            href="#ecommerce-list"
            class="mil-link mil-dark mil-arrow-place"
          >
            <span>{data.linkToList}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- intro end -->

<!-- lista usług + płatności -->
<section class="mil-dark-bg" id="ecommerce-list">
  <div class="mi-invert-fix">
    <div class="container mil-p-120-120">
      <div class="mil-center">
        <h2 class="mil-muted mil-up mil-mb-30" set:html={data.h2List} />
        <p class="mil-light-soft mil-up mil-mb-120 mil-text-justify">
          {data.listIntro}
        </p>
      </div>

      {
        ecommerceItems.map((item, index) => (
          <a
            href={`${prefix}/kontakt/`}
            class:list={[
              "mil-price-card",
              "mil-choose",
              "mil-accent-cursor",
              "mil-up",
            ]}
          >
            <div class="row align-items-center">
              <div class="col-lg-2">
                <div class="mil-price-number mil-mb-30">
                  <span class="mil-accent">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                </div>
              </div>
              <div class="col-lg-4">
                <h3 class="mil-muted mil-mb-30">{item.title}</h3>
              </div>
              <div class="col-lg-4">
                <p class="mil-light-soft mil-mb-30 mil-text-justify">
                  {item.description}
                </p>
              </div>
              <div class="col-lg-2">
                <div class="mil-adaptive-right mil-mb-30">
                  <div class="mil-button mil-icon-button-sm mil-arrow-place"></div>
                </div>
              </div>
            </div>
          </a>
        ))
      }

      <a
        href={`${prefix}/kontakt/`}
        class="mil-price-card mil-choose mil-accent-cursor mil-up mil-mb-120"
      >
        <div class="row align-items-start">
          <div class="col-lg-2">
            <div class="mil-price-number mil-mb-30">
              <span class="mil-accent">
                {String(paymentIndex).padStart(2, "0")}
              </span>
            </div>
          </div>
          <div class="col-lg-4">
            <h3 class="mil-muted mil-mb-30">{data.h2Payments}</h3>
          </div>
          <div class="col-lg-4">
            <p class="mil-light-soft mil-mb-30 mil-text-justify">
              {data.pPaymentsIntro}
            </p>
            <ul class="mil-up mil-mb-30 mil-service-list mil-light-soft">
              {paymentItems.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <p class="mil-light-soft mil-mb-30 mil-text-justify">
              {data.paymentsNote}
            </p>
          </div>
          <div class="col-lg-2">
            <div class="mil-adaptive-right mil-mb-30">
              <div class="mil-button mil-icon-button-sm mil-arrow-place"></div>
            </div>
          </div>
        </div>
      </a>

      <div class="row justify-content-center">
        <div class="col-lg-8 mil-center">
          <h2 class="mil-muted mil-up mil-mb-30">{data.ctaTitle}</h2>
          <p class="mil-light-soft mil-up mil-mb-60 mil-text-justify">
            {data.ctaText}
          </p>
          <a
            href={`${prefix}/kontakt/`}
            class="mil-button mil-arrow-place mil-up"
            title={data.ctaButton}
          >
            <span>{data.ctaButton}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
