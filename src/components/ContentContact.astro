---
const { langPrefix } = Astro.props;
const prefix = langPrefix ?? "/";
const { data } = Astro.props;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

<div class="mil-inner-banner mil-p-0-120">
  <div class="mil-banner-content mil-center mil-up">
    <div class="container">
      <ul class="mil-breadcrumbs mil-center mil-mb-60">
        <li><a href={prefix ? `${prefix}/` : "/"} title="Start">Start</a></li>
        <li><a href={`${prefix}/kontakt/`} title={data.kontakttxt01}>{data.kontakttxt01}</a></li>
      </ul>
      <h1 class="mil-mb-60" set:html={data.heading} />

      <div class="mil-divider mil-mb-60"></div>
      <div class="row justify-content-between">
        <div class="col-lg-5 mil-mb-60">
          <h2 class="mil-mb-30">Świebodzin</h2>

          <p class="mil-dark-soft mil-up" set:html={data.kontakttxt02} />
        </div>
        <div class="col-lg-5 mil-mb-60">
          <h2 class="mil-mb-30">Zielona Góra</h2>

          <p class="mil-dark-soft" set:html={data.kontakttxt03} />
        </div>
      </div>

      <a
        href="#contact"
        class="mil-link mil-dark mil-arrow-place mil-down-arrow"
      >
        <span>{data.kontakttxt04}</span>
      </a>
    </div>
  </div>
</div>

<section id="contact">
  <div class="container mil-p-120-90">
    <h3 class="mil-center mil-up mil-mb-120" set:html={data.kontakttxt05} />
    <form
      id="contactform"
      action="/send_email.php"
      method="post"
      class="row align-items-center"
      data-turnstile-missing={data.kontakttxt16}
    >
      {/* Honeypot – ukryte przed użytkownikiem, widoczne dla botów */}
      <div class="mil-hp" aria-hidden="true">
        <label for="company_url">Company URL</label>
        <input
          type="text"
          name="company_url"
          id="company_url"
          value=""
          tabindex="-1"
          autocomplete="off"
        />
      </div>
      <div class="col-lg-6 mil-up">
        <input
          type="text"
          name="name"
          id="name"
          placeholder={data.kontakttxt13}
          required
          autocomplete="name"
        />
      </div>
      <div class="col-lg-6 mil-up">
        <input
          type="email"
          name="email"
          id="email"
          placeholder={data.kontakttxt14}
          required
          autocomplete="email"
        />
      </div>
      <div class="col-lg-12 mil-up">
        <select name="subject" id="subject">
          <option value="">{data.kontakttxt06}</option>
          <option value="Strona www">{data.kontakttxt07}</option>
          <option value="Sklep internetowy">{data.kontakttxt08}</option>
          <option value="Systemy CRM-ERP">{data.kontakttxt09}</option>
          <option value="Współpraca">{data.kontakttxt10}</option>
        </select>
      </div>
      <div class="col-lg-12 mil-up">
        <textarea
          name="message"
          id="message"
          placeholder={data.kontakttxt15}
          required></textarea>
      </div>
      {
        turnstileSiteKey ? (
          <div class="col-lg-12 mil-up mil-mb-30">
            <div
              class="cf-turnstile"
              data-sitekey={turnstileSiteKey}
              data-theme="light"
            >
            </div>
          </div>
        ) : null
      }
      <div class="col-lg-8">
        <p class="mil-up mil-mb-30">
          <span class="mil-accent">*</span>
          {data.kontakttxt11}
        </p>
      </div>
      <div class="col-lg-4">
        <div class="mil-adaptive-right mil-up mil-mb-30">
          <button type="submit" class="mil-button mil-arrow-place" title={data.kontakttxt12}>
            <span>{data.kontakttxt12}</span>
          </button>
        </div>
      </div>
    </form>
  </div>
</section>

{
  turnstileSiteKey ? (
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  ) : null
}
